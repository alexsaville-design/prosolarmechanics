---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="mechanics' log · part 2" activePage="log">
  <style>
    .log-entry { max-width: 680px; padding: 40px 0 60px; }

    .entry-header { margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid #141414; }
    .entry-label { font-size: 11px; color: #4ecdc4; letter-spacing: 4px; margin-bottom: 12px; }
    .entry-title { font-family: Georgia, serif; font-size: 24px; font-weight: 400; color: #f0ece0; margin-bottom: 16px; line-height: 1.3; }
    .entry-meta { font-size: 11px; color: #666; line-height: 2; letter-spacing: 0.5px; }
    .entry-meta strong { color: #888; }

    .photo-entry { padding: 32px 0; }
    .photo-entry img { max-width: 100%; display: block; }
    .photo-entry .caption { font-size: 11px; color: #555; margin-top: 12px; letter-spacing: 1px; }

    .entry-nav { margin-top: 48px; padding-top: 24px; border-top: 1px solid #141414; display: flex; justify-content: space-between; font-size: 12px; }
    .entry-nav a { color: #666; }
    .entry-nav a:hover { color: #c9a227; }
  </style>

  <div class="log-entry">

    <div class="entry-header">
      <div class="entry-label">mechanics' log · part 2</div>
      <h1 class="entry-title">transmission without text</h1>
      <div class="entry-meta">
        <strong>timestamp:</strong> 02.05.2002<br>
        <strong>note:</strong> this entry was filed as a photograph. no report was written.
      </div>
    </div>

    <div class="photo-entry">
      <img src="/images/mech2.jpg" alt="prosolar mechanics" />
      <div class="caption">02.05.2002 · mechanic's log part 2</div>
    </div>

    <div class="entry-nav">
      <a href="/log/1.75">← part 1.75</a>
      <a href="/log/3">on to part 3 →</a>
    </div>

  </div>
</Layout>
