---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('log');
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---
<Layout title={entry.data.title} activePage="log">
  <style>
    .log-entry { max-width: 680px; padding: 40px 0 60px; }

    .entry-header { margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid #141414; }
    .entry-label { font-size: 11px; color: #4ecdc4; letter-spacing: 4px; margin-bottom: 12px; }
    .entry-title { font-family: Georgia, serif; font-size: 24px; font-weight: 400; color: #f0ece0; margin-bottom: 16px; line-height: 1.3; }
    .entry-meta { font-size: 11px; color: #666; letter-spacing: 0.5px; }

    .entry-body { font-size: 14px; color: #ccc; line-height: 1.85; }
    .entry-body p { margin-bottom: 1.4em; }
    .entry-body a { color: #c9a227; }
    .entry-body a:hover { text-decoration: underline; }
    .entry-body h1, .entry-body h2, .entry-body h3 {
      font-family: Georgia, serif;
      font-weight: 400;
      color: #f0ece0;
      margin: 1.6em 0 0.6em;
    }
    .entry-body img { max-width: 100%; display: block; margin: 1.6em 0; }
    .entry-body blockquote {
      border-left: 2px solid #333;
      padding-left: 1.2em;
      color: #888;
      margin: 1.4em 0;
    }

    .substack-link {
      margin-top: 40px;
      padding-top: 24px;
      border-top: 1px solid #141414;
      font-size: 12px;
      color: #555;
      letter-spacing: 0.5px;
    }
    .substack-link a { color: #c9a227; }

    .entry-nav { margin-top: 48px; padding-top: 24px; border-top: 1px solid #141414; font-size: 12px; }
    .entry-nav a { color: #666; }
    .entry-nav a:hover { color: #c9a227; }
  </style>

  <div class="log-entry">
    <div class="entry-header">
      <div class="entry-label">mechanics' log</div>
      <h1 class="entry-title">{entry.data.title}</h1>
      <div class="entry-meta">{dateStr}</div>
    </div>

    <div class="entry-body">
      <Content />
    </div>

    {entry.data.substackUrl && (
      <div class="substack-link">
        originally published on <a href={entry.data.substackUrl} target="_blank">substack ↗</a>
      </div>
    )}

    <div class="entry-nav">
      <a href="/log">← all log entries</a>
    </div>
  </div>
</Layout>
