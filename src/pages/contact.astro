---
import Layout from '../layouts/Layout.astro';
---
<Layout title="contact" activePage="contact">
  <style>
    .contact-block { padding: 48px 0; max-width: 480px; }
    .contact-email { font-family: Georgia, serif; font-size: 22px; color: #c9a227; font-weight: 400; }
    .contact-email a { color: #c9a227; }
    .contact-email a:hover { text-decoration: underline; }
    .contact-sub { font-size: 13px; color: #555; margin-top: 10px; line-height: 1.7; }
  </style>

  <div style="padding-top: 32px;">
    <div class="section-label">contact</div>
  </div>

  <div class="contact-block">
    <div class="contact-email">
      <a href="mailto:prosolarmechanics@gmail.com">prosolarmechanics@gmail.com</a>
    </div>
    <div class="contact-sub">for bookings, press, and transmissions.</div>
  </div>
</Layout>
