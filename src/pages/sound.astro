---
import Layout from '../layouts/Layout.astro';
---
<Layout title="sound" activePage="sound">
  <style>
    .sound-grid { padding: 32px 0; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; border-bottom: 1px solid #141414; }
    .release-card { border: 1px solid #1e1e1e; background: #0d0d0d; padding: 20px; }
    .release-card .release-title { font-family: Georgia, serif; font-size: 16px; color: #ddd; font-weight: 400; margin-bottom: 8px; }
    .release-card .release-desc { font-size: 12px; color: #666; line-height: 1.7; margin-bottom: 16px; }
    .release-card a { font-size: 12px; color: #c9a227; }
  </style>

  <div style="padding-top: 32px;">
    <div class="section-label">sound</div>
  </div>

  <div class="sound-grid">
    <div class="release-card">
      <div class="release-title">the lincoln hill demo</div>
      <div class="release-desc">early recordings from the lincoln hill sessions.</div>
      <a href="https://powerbunny4x4.bandcamp.com/album/prosolar-mechanics-lincoln-hill-demo" target="_blank">listen on bandcamp ↗</a>
    </div>
    <div class="release-card">
      <div class="release-title">urban development series vol. 4</div>
      <div class="release-desc">prosolar mechanics' contribution to the urban development series.</div>
      <a href="https://landspeedrecord.bandcamp.com/album/urban-development-series-vol-4" target="_blank">listen on bandcamp ↗</a>
    </div>
    <div class="release-card">
      <div class="release-title">turn on</div>
      <div class="release-desc">full-length album.</div>
      <a href="https://powerbunny4x4.bandcamp.com/album/prosolar-mechanics-turn-on" target="_blank">listen on bandcamp ↗</a>
    </div>
  </div>

  <div style="padding: 32px 0; text-align: center;">
    <a href="/lyrics" style="font-size: 11px; color: #f0ece0; letter-spacing: 3px; text-decoration: none; text-transform: lowercase;">lyrics</a>
  </div>

</Layout>
