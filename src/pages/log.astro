---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const substackEntries = (await getCollection('log'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="mechanics' log" activePage="log">
  <style>
    .log-intro { padding: 32px 0 24px; border-bottom: 1px solid #141414; }
    .log-intro p { font-size: 13px; color: #666; line-height: 1.7; }
    .entries { padding: 24px 0; }
    .entry { border-bottom: 1px solid #111; padding: 24px 0; display: grid; grid-template-columns: 120px 1fr; gap: 24px; }
    .entry:last-child { border-bottom: none; }
    .entry-meta { font-size: 11px; color: #555; letter-spacing: 1px; line-height: 1.8; }
    .entry-meta .entry-num { font-size: 16px; color: #333; display: block; margin-bottom: 4px; }
    .entry-body .entry-title { font-size: 15px; color: #ddd; margin-bottom: 10px; font-family: Georgia, serif; font-weight: 400; }
    .entry-body p { font-size: 13px; color: #999; line-height: 1.75; }
    .entry-body .read { font-size: 12px; color: #c9a227; margin-top: 12px; display: inline-block; }

    .section-divider { padding: 32px 0 0; }
    .new-label { font-size: 11px; color: #4ecdc4; letter-spacing: 4px; margin-bottom: 24px; }
    .archive-label { font-size: 11px; color: #4ecdc4; letter-spacing: 4px; margin-bottom: 24px; }

    .new-entries { padding: 8px 0 0; }
    .new-entry { border-bottom: 1px solid #111; padding: 24px 0; display: grid; grid-template-columns: 120px 1fr; gap: 24px; }
    .new-entry:last-child { border-bottom: none; }
    .new-entry-meta { font-size: 11px; color: #555; letter-spacing: 1px; line-height: 1.8; }
    .new-entry-body .entry-title { font-size: 15px; color: #ddd; margin-bottom: 10px; font-family: Georgia, serif; font-weight: 400; }
    .new-entry-body p { font-size: 13px; color: #999; line-height: 1.75; }
    .new-entry-body .read { font-size: 12px; color: #c9a227; margin-top: 12px; display: inline-block; }
    #substack-loading { font-size: 12px; color: #444; padding: 24px 0; letter-spacing: 1px; }

    .substack-callout {
      margin: 0 0 32px;
      border: 1px solid #1e1a10;
      border-left: 2px solid #c9a227;
      background: #0d0b08;
      padding: 20px 24px;
    }
    .substack-callout p { font-size: 13px; color: #999; line-height: 1.7; margin-bottom: 12px; }
    .substack-callout a { color: #4ecdc4; }

    @media (max-width: 640px) {
      .entry, .new-entry { grid-template-columns: 1fr; gap: 8px; }
    }
  </style>

  <div class="log-intro">
    <div class="section-label">mechanics' log</div>
    <p>an ongoing account of missions, thoughts, and transmissions — from 1997 to the present.</p>
  </div>

  <div class="section-divider">
    <div class="new-label">new transmissions</div>
    {substackEntries.length > 0 ? (
      <div class="new-entries">
        {substackEntries.map(entry => (
          <div class="new-entry">
            <div class="new-entry-meta">
              {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')}
            </div>
            <div class="new-entry-body">
              <div class="entry-title">{entry.data.title}</div>
              {entry.data.description && <p>{entry.data.description}</p>}
              <a href={`/log/${entry.slug}`} class="read">read →</a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="substack-callout">
        <p>new writing from the mechanics — <a href="https://prosolarmechanics.substack.com" target="_blank">read on substack ↗</a></p>
      </div>
    )}
  </div>

  <div class="section-divider">
    <div class="archive-label">archive · 1997–2004</div>
    <div class="substack-callout">
      <p>new writing is published to <a href="https://prosolarmechanics.substack.com" target="_blank">the band substack</a> and appears above.</p>
    </div>
  </div>

  <div class="entries">

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">11</span>2003</div>
      <div class="entry-body">
        <div class="entry-title">part four</div>
        <p>i think the space is all there is. your body is just biology that puts a boundary around some of it.</p>
        <a href="/log/11" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">10</span>06.02.2002</div>
      <div class="entry-body">
        <div class="entry-title">daylight</div>
        <p>i no longer believe the mechanics are coming. i've been waiting but i'm pretty certain i've had it wrong for most of the whole time.</p>
        <a href="/log/10" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">9</span>05.11.2002</div>
      <div class="entry-body">
        <div class="entry-title">resuscitate mechanics</div>
        <p>maybe you wonder if we have given up. but you are quite mistaken if you do.</p>
        <a href="/log/9" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">8</span>10.2001</div>
      <div class="entry-body">
        <div class="entry-title">wheels on the road</div>
        <p>athens ga with the strokes next door. halloween in murfreesboro. boone. blacksburg. two weeks on the road post-9/11 with plug spark sanjay.</p>
        <a href="/log/8" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">7</span>07.2001</div>
      <div class="entry-body">
        <div class="entry-title">the cartography of sound</div>
        <p>dave reynolds leaves. tommy bendel joins. maxwell's independent music festival. the farm party. boston.</p>
        <a href="/log/7" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">6</span>10.2000</div>
      <div class="entry-body">
        <div class="entry-title">fall road missions and a dream about road to flight</div>
        <p>maxwell's IMF, the sidebar baltimore, blacksburg virginia, and a never-finished night in boone nc.</p>
        <a href="/log/6" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">51</span>08.19.2000</div>
      <div class="entry-body">
        <div class="entry-title">field report from boonefest 2000 · special edition</div>
        <p>hallelujah! let me tell you about boonefest. first of all, i suck for not being there the first two days...</p>
        <a href="/log/51" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">5</span>06.04.2000</div>
      <div class="entry-body">
        <div class="entry-title">mission to WE2K — wilmington, north carolina</div>
        <p>dave's wheel falls off his truck. three drummers learn the set in 28 hours. the most memorable show we ever played.</p>
        <a href="/log/5" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">4</span>02.01.2000</div>
      <div class="entry-body">
        <div class="entry-title">maxwell's, the brighton bar, and earth day with ween</div>
        <p>selling out maxwell's with plug spark sanjay. tuning to D# instead of D in front of juliana hatfield and ween.</p>
        <a href="/log/4" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">3</span>10.1999</div>
      <div class="entry-body">
        <div class="entry-title">capt. cook's, the continental, and the party at the hub</div>
        <p>new brunswick, nyc with britt daniel and rye coalition, and an after-party that went until 8am.</p>
        <a href="/log/3" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">2</span>02.05.2002</div>
      <div class="entry-body">
        <div class="entry-title">transmission without text</div>
        <p>this entry was filed as a photograph. no report was written.</p>
        <a href="/log/2" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">1.75</span>04.1999</div>
      <div class="entry-body">
        <div class="entry-title">arlene grocery and the night about violence</div>
        <p>manhattan, a mobbed club, a fight on the sidewalk, and a lost entry from the court tavern.</p>
        <a href="/log/1.75" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">1.5</span>09.1998</div>
      <div class="entry-body">
        <div class="entry-title">jersey beat night, the court tavern, and satellite ramblings</div>
        <p>september 1998 through february 1999. shows, aborted entries, and a night with elvis '77.</p>
        <a href="/log/1.5" class="read">read →</a>
      </div>
    </div>

    <div class="entry">
      <div class="entry-meta"><span class="entry-num">1</span>01.10.1998</div>
      <div class="entry-body">
        <div class="entry-title">entries from the early missions</div>
        <p>the saint, the budapest, we fest wilmington, coney island high. january through september, 1998.</p>
        <a href="/log/1" class="read">start here and read forward →</a>
      </div>
    </div>

  </div>

  <div style="padding: 32px 0 16px; border-top: 1px solid #0f0f0f; margin-top: 8px;">
    <p style="font-size: 12px; color: #444; line-height: 1.8;">each entry links to the next — <a href="/log/1" style="color:#666;">start at part 1</a> and follow the nav forward through time.</p>
  </div>

</Layout>
