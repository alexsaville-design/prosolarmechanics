---
interface Props {
  title?: string;
  activePage?: string;
}
const { title = 'prosolar mechanics', activePage = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="prosolar mechanics — sound breaking the monotony of space" />
  <title>{title === 'prosolar mechanics' ? title : `${title} · prosolar mechanics`}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #080808;
      font-family: Verdana, Arial, sans-serif;
      font-size: 13px;
      color: #ddd;
      line-height: 1.6;
    }

    a { color: #c9a227; text-decoration: none; }
    a:hover { text-decoration: underline; }

    .hero {
      position: relative;
      width: 100%;
      height: 300px;
      overflow: hidden;
    }
    .hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.05) 50%, rgba(0,0,0,0.75) 100%);
    }
    .hero-text {
      position: absolute;
      top: 32px;
      left: 40px;
    }
    .hero-text h1 {
      font-family: Georgia, serif;
      font-size: 34px;
      font-weight: 400;
      color: #f0ece0;
      letter-spacing: 0.5px;
    }
    .hero-text h1 a {
      color: #f0ece0;
      text-decoration: none;
    }
    .hero-text .tagline {
      font-size: 11px;
      color: #4ecdc4;
      letter-spacing: 4px;
      margin-top: 8px;
    }

    nav {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(0,0,0,0.75);
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 14px 40px;
      display: flex;
      align-items: center;
      gap: 0;
    }
    nav a {
      color: #999;
      text-decoration: none;
      font-size: 12px;
      letter-spacing: 1.5px;
      padding-right: 14px;
      transition: color 0.15s;
    }
    nav a:hover { color: #c9a227; text-decoration: none; }
    nav a.active { color: #c9a227; }
    nav .sep { color: #252525; padding-right: 14px; font-size: 12px; }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .section-label {
      font-size: 11px;
      color: #4ecdc4;
      letter-spacing: 4px;
      margin-bottom: 20px;
      text-transform: lowercase;
    }

    footer {
      margin-top: 40px;
      padding: 16px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #0f0f0f;
    }
    footer span {
      font-size: 11px;
      color: #666;
      letter-spacing: 1px;
    }

    @media (max-width: 640px) {
      .hero { height: 260px; }

      .hero-overlay {
        background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.05) 40%, rgba(0,0,0,0.85) 100%);
      }

      .hero-text {
        top: auto;
        bottom: 52px;
        left: 20px;
      }

      .hero-text h1 { font-size: 26px; }
      .hero-text .tagline { font-size: 10px; letter-spacing: 3px; }

      nav {
        padding: 10px 20px;
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
      }

      nav a { font-size: 11px; letter-spacing: 1px; padding-right: 10px; white-space: nowrap; }
      nav .sep { padding-right: 10px; }

      .container { padding: 0 20px; }

      footer { padding: 16px 20px; flex-direction: column; gap: 4px; text-align: center; }
    }
  </style>
</head>
<body>
  <div class="hero">
    <img src="/images/hero.jpg" alt="prosolar mechanics" />
    <div class="hero-overlay"></div>
    <div class="hero-text">
      <h1><a href="/">prosolar mechanics</a></h1>
      <div class="tagline">sound breaking the monotony of space</div>
    </div>
    <nav>
      <a href="/log" class={activePage === 'log' ? 'active' : ''}>mechanics' log</a>
      <span class="sep">|</span>
      <a href="/sound" class={activePage === 'sound' ? 'active' : ''}>sound</a>
      <span class="sep">|</span>
      <a href="/press" class={activePage === 'press' ? 'active' : ''}>press</a>
      <span class="sep">|</span>
      <a href="/dates" class={activePage === 'dates' ? 'active' : ''}>dates</a>
      <span class="sep">|</span>
      <a href="/manifesto" class={activePage === 'manifesto' ? 'active' : ''}>manifesto</a>
      <span class="sep">|</span>
      <a href="/operations-manual" class={activePage === 'operations-manual' ? 'active' : ''}>operations manual</a>
      <span class="sep">|</span>
      <a href="/contact" class={activePage === 'contact' ? 'active' : ''}>contact</a>
    </nav>
  </div>

  <div class="container">
    <slot />
  </div>

  <footer>
    <span>prosolar mechanics · est. 1997</span>
    <span>&copy; prosolar mechanics 2026</span>
  </footer>
</body>
</html>
